# =====================================================================
# TruthTrace Environment Variables & Deployment Configuration
# =====================================================================

# 1. Gemini API Key (REQUIRED for AI Claim Extraction)
# Obtain from Google AI Studio: https://aistudio.google.com/
# On Vercel: Add GEMINI_API_KEY in Project Settings -> Environment Variables
# On Render: Add GEMINI_API_KEY in Environment Variables
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Optional Standalone Backend URL
# If hosting the Python FastAPI backend on Render or external server:
# Set VITE_API_BASE_URL on Vercel to point to your Render backend URL (e.g. https://truthtrace-backend.onrender.com)
VITE_API_BASE_URL=""

# 3. FASTAPI Backend Internal URL (Used by Node server or Vercel serverless proxy if forwarding)
FASTAPI_BACKEND_URL="http://127.0.0.1:8000"

# 4. Port Configuration (Defaults to 3000 for Node / 8000 for Python)
PORT=3000
